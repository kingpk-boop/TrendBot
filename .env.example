# TrendBot settings. Copy this file, name the copy ".env" (just .env, nothing before the dot),
# and fill in only what you need. Never share your .env file or commit it anywhere.
# After changing it, close TrendBot and start it again.
#
# Paper mode for crypto needs NO keys at all.
# Live keys: allow SPOT TRADING ONLY. Never enable withdrawals, futures or margin.

# --- Binance -----------------------------------------------------------------
# Practice keys from https://testnet.binance.vision/
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# Real-money keys (Binance > Account > API Management)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Bybit -------------------------------------------------------------------
# Practice keys from https://testnet.bybit.com/
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=
# Real-money keys
BYBIT_API_KEY=
BYBIT_API_SECRET=

# --- Alpaca (US stocks) ------------------------------------------------------
# Free paper-trading keys from https://alpaca.markets/ (needed even for paper mode,
# because stock prices come from Alpaca)
ALPACA_TESTNET_API_KEY=
ALPACA_TESTNET_API_SECRET=
# Real-money keys
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Price feed: "iex" works with free accounts; "sip" needs a paid data plan
ALPACA_FEED=iex

# --- Web app -----------------------------------------------------------------
# Needed only to open TrendBot from your phone (start.bat --host 0.0.0.0).
# Use a long password you don't use anywhere else.
BOT_UI_PASSWORD=
