{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "fra1"
  ],
  "functions": {
    "index.py": {
      "maxDuration": 300,
      "excludeFiles": "{frontend/**,tools/**,data/**,.venv/**,*.bat,Dockerfile,render.yaml,README.md,TUTORIAL.md}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/tick",
      "schedule": "7 12 * * *"
    }
  ]
}
